# ==============================================================================
# Sweety - Blood Glucose Tracker Configuration
# Copy this file to .env and replace placeholder values with your local settings.
# NEVER commit the actual .env file or expose real credentials in source control.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000

# Client URL (for CORS and CSRF origin validation)
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Configuration
# Format: postgresql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:your_local_postgres_password@localhost:5432/blood_glucose_tracker_db

# Direct PostgreSQL connection parameters (alternative to DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blood_glucose_tracker_db
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password

# Authentication & Session Secrets (generate distinct 64-char random secrets in production; never commit real secrets)
JWT_SECRET=replace_with_secure_random_jwt_secret_min32chars
COOKIE_SECRET=replace_with_secure_random_cookie_secret_min32chars
CSRF_SECRET=replace_with_secure_random_csrf_secret_min32chars

# Security & Password Hashing
BCRYPT_SALT_ROUNDS=12
SESSION_EXPIRY_DAYS=7
