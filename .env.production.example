# ==============================================================================
# Sweety - Blood Glucose Tracker Production Environment Template
# Copy this file to .env on your production host and configure the secret values.
# NEVER commit the actual production .env file or real credentials to Git.
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5000

# Client Application URL (For CORS and CSRF origin validation)
# Set this to your production domain (e.g. https://sweety.example.com).
# If Express is serving the static frontend from the same origin, leave as is or set to your domain.
CLIENT_URL=https://sweety.example.com

# PostgreSQL Production Database URL
# Most cloud providers (Supabase, Neon, AWS RDS, Railway, Render) supply a connection string.
# SSL is automatically enabled with { rejectUnauthorized: false } when NODE_ENV=production.
DATABASE_URL=postgresql://postgres_user:strong_password@prod-db.example.com:5432/blood_glucose_tracker_db?sslmode=require

# Application Secrets (MANDATORY in production; must be at least 32 characters, preferably 64-char hex)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_cryptographically_strong_random_jwt_secret_min32chars
COOKIE_SECRET=replace_with_a_cryptographically_strong_random_cookie_secret_min32chars
CSRF_SECRET=replace_with_a_cryptographically_strong_random_csrf_secret_min32chars

# Security & Session Settings
BCRYPT_SALT_ROUNDS=12
SESSION_EXPIRY_DAYS=7

# Application Timezone (IANA Timezone identifier)
APP_TIMEZONE=Asia/Kolkata
